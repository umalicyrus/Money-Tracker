# Copy to .env.deploy on the SERVER. Never overwrite backend/.env.
# Claim an available DuckDNS name first; this name is an example, not reserved.
APP_HOST=your-unique-moneytracker.duckdns.org
FRONTEND_URL=https://money-tracker.vercel.app
SANCTUM_STATEFUL_DOMAINS=money-tracker.vercel.app
# Replace the example Vercel hostname with your assigned stable production alias.
ACME_EMAIL=you@example.com
# Generate and securely retain a Laravel base64 key; preserve the original key
# when moving an existing installation. Never generate a new key on redeploy.
APP_KEY=
# Generate two different random passwords. Blank values intentionally fail startup.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Tag each app/web build for rollback; never retag the MariaDB data version casually.
RELEASE_TAG=initial

{
    email {$ACME_EMAIL}
}

{$APP_HOST} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }

    @private path /.env* /.git/* /storage/* /vendor/* /index.php
    handle @private {
        respond 404
    }

    @backend path /api /api/* /sanctum /sanctum/* /login /login/* /logout /logout/* /up
    handle @backend {
        root * /var/www/html/public
        header Cache-Control "private, no-store"
        header CDN-Cache-Control "no-store"
        header Vercel-CDN-Cache-Control "no-store"
        # Caddy supplies HTTPS and the original Host directly through FastCGI.
        # No public HTTP proxy or wildcard forwarded-header trust is needed.
        php_fastcgi app:9000
    }

    handle /assets/* {
        root * /srv/frontend
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    @pwa path /sw.js /manifest.webmanifest /favicon.svg /icons.svg /app-icon.svg
    handle @pwa {
        root * /srv/frontend
        header Cache-Control "no-cache"
        file_server
    }

    handle {
        root * /srv/frontend
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}

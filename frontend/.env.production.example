# Public build-time value. Vercel proxies /api, /sanctum, /login and /logout.
# Do not use the Oracle/DuckDNS URL here: it breaks first-party Sanctum cookies.
VITE_API_BASE_URL=/
# External API hostname is configured in vercel.json destinations, not this file.
# Never put APP_KEY, DB passwords or tokens into VITE_* variables.

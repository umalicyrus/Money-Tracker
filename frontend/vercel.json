{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://money-tracker-production-3852.up.railway.app/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://money-tracker-production-3852.up.railway.app/sanctum/:path*" },
    { "source": "/login", "destination": "https://money-tracker-production-3852.up.railway.app/login" },
    { "source": "/logout", "destination": "https://money-tracker-production-3852.up.railway.app/logout" },
    { "source": "/up", "destination": "https://money-tracker-production-3852.up.railway.app/up" },
    { "source": "/storage/:path*", "destination": "https://money-tracker-production-3852.up.railway.app/storage/:path*" },
    { "source": "/((?!api(?:/|$)|sanctum(?:/|$)|login(?:/|$)|logout(?:/|$)|up(?:/|$)|storage(?:/|$)|assets/|sw\\.js$|manifest\\.webmanifest$|app-icon\\.svg$|favicon\\.svg$|icons\\.svg$).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/:path*", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/:service(api|sanctum|login|logout|up|storage)/:path*", "headers": [
      { "key": "Cache-Control", "value": "private, no-store" },
      { "key": "CDN-Cache-Control", "value": "no-store" },
      { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
      { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
    ] },
    { "source": "/sw.js", "headers": [
      { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
      { "key": "Service-Worker-Allowed", "value": "/" }
    ] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
